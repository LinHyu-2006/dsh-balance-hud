{
  "name": "dsh-balance-hud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH Web GUI 右下角常驻 HUD：显示 DeepSeek 账户余额与本会话花费（官方价格表预估 + 余额减少量实际值），含充值自动识别",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "balance",
    "cost",
    "hud"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
