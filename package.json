{
  "name": "dsh-balance-hud",
  "version": "1.0.0",
  "type": "module",
  "description": "Balance and per-session spend HUD for the DSH Web GUI: shows your DeepSeek balance and what this session has cost, with budget alerts, peak-hour warnings and opt-in official price sync.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "balance",
    "cost",
    "hud"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinHyu-2006/dsh-balance-hud.git"
  },
  "bugs": {
    "url": "https://github.com/LinHyu-2006/dsh-balance-hud/issues"
  },
  "homepage": "https://github.com/LinHyu-2006/dsh-balance-hud#readme",
  "engines": {
    "dsh": ">=0.1.7-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
